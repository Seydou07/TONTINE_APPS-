{
  "expo": {
    "name": "Venega",
    "slug": "venega",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "venega",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aniss.venega"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.aniss.venega",
      "permissions": ["android.permission.CALL_PHONE"],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Venega utilise Face ID pour déverrouiller l’application."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-badge.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#074B36"
        }
      ],
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bbd58570-b17a-4f14-8fc2-af3978f294c1"
      }
    },
    "owner": "geek2.0"
  }
}
